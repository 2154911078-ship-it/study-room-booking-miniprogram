/* pages/index 首页样式（公共原子类见 styles/common.wxss） */

.hero {
  background: linear-gradient(160deg, #3d6bff 0%, #1e43d8 100%);
  padding: 28rpx 32rpx 96rpx;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}
.brand .logo {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.brand-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}
.brand-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 6rpx;
}
.user-chip {
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  max-width: 200rpx;
  overflow: hidden;
  white-space: nowrap;
}

/* 公告纵向轮播 */
.notice-swiper {
  height: 72rpx;
  margin-top: 28rpx;
}
.notice {
  height: 72rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
}
.notice-ico {
  margin-right: 14rpx;
  font-size: 26rpx;
}
.notice-txt {
  color: #fff;
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.body {
  padding: 0 24rpx 40rpx;
  margin-top: -56rpx;
}

/* 数据概览 */
.stats {
  padding: 28rpx 0;
}
.stat-cell {
  display: flex;
}
.stat-cell text {
  display: block;
  text-align: center;
}
.stat-cell .t-num {
  margin-bottom: 4rpx;
}
.stat-line {
  width: 2rpx;
  height: 64rpx;
  background: var(--c-line);
}

/* 搜索入口 */
.search-box {
  margin-top: 24rpx;
  height: 84rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 0 30rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 36, 48, 0.05);
  box-sizing: border-box;
}
.search-ico {
  margin-right: 16rpx;
  font-size: 28rpx;
}
.search-ph {
  color: var(--c-text-weak);
  font-size: 26rpx;
}

/* 轮播 */
.banner {
  height: 240rpx;
  margin-top: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
}
.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
}
.banner-img {
  width: 100%;
  height: 100%;
}
.banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 56rpx 32rpx 24rpx;
  background: linear-gradient(180deg, transparent, rgba(15, 24, 51, 0.66));
}
.banner-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}
.banner-sub {
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
  margin-top: 4rpx;
}

/* 快捷入口 */
.quick {
  display: flex;
  margin: 32rpx 0 8rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 0;
  box-shadow: 0 6rpx 20rpx rgba(31, 36, 48, 0.05);
}
.quick-item {
  flex: 1;
}
.quick-ico {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 图标：项目自制 PNG（240x240 透明底），透明 PNG 在浅色圆角方块里居中显示 */
.quick-ico-img {
  width: 52rpx;
  height: 52rpx;
  display: block;
}
.quick-ico-wrap {
  position: relative;
}
.quick-ico-wrap .badge {
  position: absolute;
  top: -8rpx;
  right: -14rpx;
}
.quick-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--c-text-sub);
}

/* 热门自习室横滑：竖版卡片，一屏一张半，间距统一 */
.hot-scroll {
  width: 100%;
  padding-bottom: 12rpx; /* 给卡片投影留空间，避免被 scroll-view 裁切 */
}
.hot-list {
  display: inline-flex;
  gap: 24rpx;
  padding-right: 4rpx;
}
.hot-item {
  width: 460rpx;
  flex-shrink: 0;
}

.foot-brand {
  margin-top: 48rpx;
  color: var(--c-text-weak);
  font-size: 22rpx;
}
.foot-note {
  margin-top: 8rpx;
  color: var(--c-warn);
  font-size: 22rpx;
}
