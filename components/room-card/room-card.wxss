.room-card {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 36, 48, 0.05);
}
.room-card-hover {
  transform: scale(0.985);
  box-shadow: 0 2rpx 10rpx rgba(31, 36, 48, 0.08);
}
.cover {
  width: 200rpx;
  height: 168rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #eef0f5;
}
.info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.name {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2430;
}
.rc-status {
  flex-shrink: 0;
}
.loc {
  font-size: 24rpx;
  color: #5b6472;
  margin-top: 6rpx;
}
.tags {
  display: flex;
  flex-wrap: nowrap;
  overflow: hidden;
  margin-top: 10rpx;
}
.tag-plain-item {
  background: #f2f4f9;
  color: #5b6472;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.foot {
  margin-top: 12rpx;
}
.foot-l {
  min-width: 0;
  margin-right: 12rpx;
}
.free {
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* ------- 竖版卡片：首页“热门自习室”横滑区（上图下文） ------- */
.rc-v {
  flex-direction: column;
  padding: 0;
  overflow: hidden;
}
.rc-v .cover {
  width: 100%;
  height: 240rpx;
  border-radius: 0;
}
.rc-v .info {
  margin-left: 0;
  padding: 20rpx 24rpx 24rpx;
}
.rc-v .foot {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f2f7;
}
